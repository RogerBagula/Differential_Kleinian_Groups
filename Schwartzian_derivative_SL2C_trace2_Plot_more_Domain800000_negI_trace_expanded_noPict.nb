 RowBox[{
  RowBox[{"w", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{"1"},
        "C"], "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["x", "2"], "-", 
            RowBox[{"2", " ", 
             TemplateBox[{"1"},
              "C"]}], "-", 
            RowBox[{"2", " ", "x", " ", 
             TemplateBox[{"1"},
              "C"]}], "+", 
            FractionBox["2", 
             RowBox[{"1", "+", 
              RowBox[{"2", " ", 
               TemplateBox[{"1"},
                "C"]}]}]], "-", 
            FractionBox[
             RowBox[{"2", " ", "x"}], 
             RowBox[{"1", "+", 
              RowBox[{"2", " ", 
               TemplateBox[{"1"},
                "C"]}]}]], "+", 
            FractionBox[
             RowBox[{"6", " ", 
